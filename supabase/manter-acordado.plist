<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mantém o Supabase acordado (README → "Manter o projeto acordado").
  Chama o ping() a cada 6 dias. O launchd só confere de hora em hora (e ao ligar o Mac ou abrir a
  sessão) se já passaram 6 dias desde a última chamada que deu 200 — a data dela é a do arquivo
  ~/Library/Logs/supabase-acordado.ultimo; se não passaram, sai sem fazer nada. Chamada que falha
  não conta: tenta de novo na hora seguinte. (O StartInterval do launchd não serve: para enquanto
  o Mac dorme e zera ao reiniciar.)
  Registro de cada chamada em ~/Library/Logs/supabase-acordado.log (200 = ok, 404 = falta a
  alteração 02, 000 = sem rede).
  Instalar: copiar para ~/Library/LaunchAgents/ e rodar
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.revisor.supabase-acordado.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.revisor.supabase-acordado</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>f="$HOME/Library/Logs/supabase-acordado.ultimo"
ult=$(stat -f %m "$f" 2>/dev/null || echo 0)
if [ $(( $(date +%s) - ult )) -lt 518400 ]; then exit 0; fi
c=$(/usr/bin/curl -s -m 30 -o /dev/null -w '%{http_code}' -X POST https://vosdzokcqnbxmrqqrpkv.supabase.co/rest/v1/rpc/ping -H 'apikey: sb_publishable_TswOKTJJWewwYwS1FoFKbw_HDXO-R0J' -H 'Content-Type: application/json')
echo "$(date '+%Y-%m-%d %H:%M') $c"
if [ "$c" = 200 ]; then touch "$f"; fi</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/pedroviana/Library/Logs/supabase-acordado.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/pedroviana/Library/Logs/supabase-acordado.log</string>
</dict>
</plist>
